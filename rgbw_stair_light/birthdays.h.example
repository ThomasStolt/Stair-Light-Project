// =============================================================================
// Birthdays – only "birthday" animation on these days
// =============================================================================
// Instructions:
// 1. Copy this file to:  birthdays.h
// 2. birthdays.h is in .gitignore and will not be committed to GitHub.
// 3. Set BIRTHDAY_COUNT below and add entries (month, day).
//    Month 1–12, day 1–31. Format: BIRTHDAY(month, day)
// =============================================================================

#ifndef BIRTHDAYS_H
#define BIRTHDAYS_H

#define BIRTHDAY_COUNT 2

#define BIRTHDAY(month, day)  { (month), (day) }

// List: (month, day) – e.g. 15 March and 24 December
static const uint8_t BIRTHDAYS[BIRTHDAY_COUNT][2] = {
  BIRTHDAY(3, 15),   // 15 March
  BIRTHDAY(12, 24),  // 24 December
};

#endif /* BIRTHDAYS_H */
